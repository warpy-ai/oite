# What a release of oitec ships with. Change these in a pull request; the
# release workflow (.github/workflows/release.yml) reads them.

# warpy-ai/unroll commit bundled as unroll-src.tar.gz.
UNROLL_REF=1f27b06c91b956e5c60ee157e2e78fe56bf0e06b

# warpy-ai/rolls commit the core rolls are taken from.
ROLLS_REF=8f9f84336745e07014075906cecbd4fa8bb5397a

# The core rolls bundled with oitec (docs/docs/platform-architecture.md).
# Each must be published on the registry at the version its roll.toml has at
# ROLLS_REF, and every roll they depend on must be in this list.
CORE_ROLLS="std array string math json async"
