// backends: vm jit aot
// #121, #140: runtime errors are ordinary exceptions: catchable, with the
// standard names and messages, on every backend. (`instanceof` and `new`
// need classes, which native code does not compile yet: error_classes.ot.)

function attempt(label, f) {
  try {
    f();
    console.log(label, "no error");
  } catch (e) {
    console.log(label, e.name, "|", e.message);
  }
}

attempt("null read", function () { let o = null; return o.x; });
attempt("undefined write", function () { let o; o.x = 1; });
attempt("computed read", function () { let o = null; return o["k"]; });
attempt("method on null", function () { let o = null; o.go(); });
attempt("missing method", function () { let o = {}; o.go(); });
attempt("call non-function", function () { let f = 5; f(); });
attempt("unbound name", function () { return notDefinedAnywhere; });
attempt("range", function () { "x".repeat(-1); });

// Printed and converted like any error.
try {
  null.x;
} catch (e) {
  console.log(e);
  console.log(String(e), "" + e, `${e}`);
}

// Execution continues after a caught runtime error.
let after = 0;
for (let i = 0; i < 3; i++) {
  try {
    if (i == 1) null.x;
    after++;
  } catch (e) {
    after += 10;
  }
}
console.log(after);

// A runtime error inside a callee unwinds to the caller's catch.
function inner() { return undefined.y; }
function outer() { return inner(); }
try {
  outer();
} catch (e) {
  console.log("outer caught", e.message);
}
