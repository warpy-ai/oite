// backends: vm jit aot
// `%` takes the sign of the dividend, is -0 for a negative dividend that
// divides exactly, and is NaN for a zero divisor. Native code computes
// integers with an integer remainder and everything else as a double.
function show(x) {
  // Tell -0 from 0.
  return x === 0 && 1 / x < 0 ? "-0" : "" + x;
}
function mod(a, b) {
  return a % b;
}
let cases = [
  [7, 3], [-7, 3], [7, -3], [-7, -3], [6, 3], [-6, 3], [0, 5], [-0, 5],
  [5, 0], [-5, 0], [0, 0], [5.5, 2], [-5.5, 2], [5, 2.5], [0.3, 0.1],
  [9007199254740993, 2], [9007199254740992, 3], [-9007199254740992, 7],
  [1e300, 7], [Infinity, 3], [3, Infinity], [-3, -Infinity], [NaN, 3], [3, NaN],
  [2147483648, 10], [-2147483649, 10], [1, -1], [-9223372036854775808, -1],
];
let out = [];
for (let i = 0; i < cases.length; i++) {
  out.push(show(mod(cases[i][0], cases[i][1])));
}
console.log(out.join(" "));
// Operands that are not numbers go through the runtime.
let o = { valueOf() { return 10; } };
console.log(show(mod("17", 5)), show(mod(o, 4)), show(mod(true, 2)), show(mod(null, 3)), show(mod(undefined, 3)));
// Constants the compiler sees.
console.log(show(17 % 5), show(-17 % 5), show(17.5 % 5), show(-4 % 2));
// A loop: the integer path, many times.
let sum = 0;
for (let i = 0; i < 100000; i++) {
  sum = (sum + i * i) % 1000003;
}
console.log(sum);
