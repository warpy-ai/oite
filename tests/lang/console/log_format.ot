// #134: console.log joins arguments with a space and prints structures.
console.log("a", "b", 1, true);
console.log([1, 2, 3]);
console.log({ x: 1, y: "s" });
console.log([]);
console.log({});
console.log(0.1 + 0.2);
console.log(1 / 0, -1 / 0, 0 / 0);
console.log("n=" + 1 / 0);
console.log([1, [2, [3, [4, [5]]]]]);
console.log({ a: { b: { c: { d: 1 } } } });
console.log(null, undefined);
console.log(["it's", "x"]);
console.log({ "a-b": 1 });
function f() {}
console.log(f);
