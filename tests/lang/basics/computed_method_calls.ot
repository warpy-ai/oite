// backends: vm jit aot
// A call through a computed member, `o[k](args)`, is a method call: the
// receiver is `this`, as in `o.k(args)`.
const o = {
  k: 5,
  m() {
    return this.k;
  },
  add(a, b) {
    return this.k + a + b;
  },
};
console.log(o["m"]());
const key = "m";
console.log(o[key]());
console.log(o["add"](1, 2), o["a" + "dd"](3, 4));

class C {
  constructor() {
    this.v = 1;
  }
  get1() {
    return this.v;
  }
  run(name) {
    return this[name]() + 10;
  }
}
console.log(new C()["get1"]());
console.log(new C().run("get1"));

// Built-in methods, and methods a program adds to `Array.prototype`.
const s = "abc";
console.log(s["toUpperCase"]());
console.log([1, 2]["join"]("+"));
Array.prototype.twice = function () {
  return this.length * 2;
};
console.log([1, 2, 3]["twice"]());

// An array element: `this` is the array. The key is evaluated once.
const fns = [
  function () {
    return this.length;
  },
  function () {
    return "second";
  },
];
let i = 0;
console.log(fns[0](), fns[i + 1](), fns["0"]());
console.log(fns[i++](), i);

// Functions that are not compiled ones: natives, `String`, and a promise's
// `resolve`, through a computed member and as a method.
const mk = "max";
console.log(Math["max"](1, 3), Math[mk](4, 2));
const conv = [String];
const names = { S: String };
console.log(conv[0](5) + "|", names["S"](6) + "|", names.S(7) + "|");
const resolvers = {};
const p = new Promise((resolve) => {
  resolvers["first"] = resolve;
});
const q = new Promise((resolve) => {
  resolvers.second = resolve;
});
resolvers["first"]("one");
resolvers.second("two");
p.then((v) => console.log("resolved", v));
q.then((v) => console.log("resolved", v));

// Optional calls.
const none = null;
console.log(o?.["m"](), o["m"]?.(), o?.[key](), o[key]?.());
console.log(none?.["m"](), none?.[key](), o["nope"]?.(), o[key + "x"]?.());
