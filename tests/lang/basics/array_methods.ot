// backends: vm jit aot
// Array methods (one implementation shared by every backend).
let a = [1, 2, 3];
console.log(a.unshift(0), a);
console.log(a.shift(), a);
console.log(a.join(), a.join("-"), [1, null, undefined, [2, 3]].join());
console.log(a.indexOf(2), a.indexOf(9), a.lastIndexOf(3), a.includes(3), [NaN].includes(NaN));
console.log(a.slice(1), a.slice(-2, -1), a.at(-1), a.at(5));
console.log(a.concat([4, 5], 6), a);
let b = [1, 2, 3, 4, 5];
console.log(b.splice(1, 2), b);
console.log(b.splice(1, 0, "x", "y"), b);
console.log(b.splice(-2), b);
console.log([1, 2, 3].reverse(), [0, 0, 0, 0].fill(7, 1, 3));
let words = "the quick brown fox".split(" ");
console.log(words.length, words.indexOf("brown"), words.slice(1, 3).join(" "));
