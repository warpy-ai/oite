// The n-body simulation from the Computer Language Benchmarks Game.
const PI = 3.141592653589793;
const SOLAR_MASS = 4 * PI * PI;
const DAYS = 365.24;
function body(x, y, z, vx, vy, vz, mass) {
  return { x: x, y: y, z: z, vx: vx * DAYS, vy: vy * DAYS, vz: vz * DAYS, mass: mass * SOLAR_MASS };
}
function bodies() {
  return [
    body(0, 0, 0, 0, 0, 0, 1),
    body(4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01, 1.66007664274403694e-03, 7.69901118419740425e-03, -6.90460016972063023e-05, 9.54791938424326609e-04),
    body(8.34336671824457987e+00, 4.12479856412430479e+00, -4.03523417114321381e-01, -2.76742510726862411e-03, 4.99852801234917238e-03, 2.30417297573763929e-05, 2.85885980666130812e-04),
    body(1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01, 2.96460137564761618e-03, 2.37847173959480950e-03, -2.96589568540237556e-05, 4.36624404335156298e-05),
    body(1.53796971148509165e+01, -2.59193146099879641e+01, 1.79258772950371181e-01, 2.68067772490389322e-03, 1.62824170038242295e-03, -9.51592254519715870e-05, 5.15138902046611451e-05),
  ];
}
function offset(bs) {
  let px = 0; let py = 0; let pz = 0;
  for (let i = 0; i < bs.length; i++) { let b = bs[i]; px = px + b.vx * b.mass; py = py + b.vy * b.mass; pz = pz + b.vz * b.mass; }
  bs[0].vx = -px / SOLAR_MASS; bs[0].vy = -py / SOLAR_MASS; bs[0].vz = -pz / SOLAR_MASS;
}
function energy(bs) {
  let e = 0;
  for (let i = 0; i < bs.length; i++) {
    let b = bs[i];
    e = e + 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz);
    for (let j = i + 1; j < bs.length; j++) {
      let c = bs[j];
      let dx = b.x - c.x; let dy = b.y - c.y; let dz = b.z - c.z;
      e = e - (b.mass * c.mass) / Math.sqrt(dx * dx + dy * dy + dz * dz);
    }
  }
  return e;
}
function advance(bs, dt) {
  let n = bs.length;
  for (let i = 0; i < n; i++) {
    let b = bs[i];
    for (let j = i + 1; j < n; j++) {
      let c = bs[j];
      let dx = b.x - c.x; let dy = b.y - c.y; let dz = b.z - c.z;
      let d2 = dx * dx + dy * dy + dz * dz;
      let mag = dt / (d2 * Math.sqrt(d2));
      b.vx = b.vx - dx * c.mass * mag; b.vy = b.vy - dy * c.mass * mag; b.vz = b.vz - dz * c.mass * mag;
      c.vx = c.vx + dx * b.mass * mag; c.vy = c.vy + dy * b.mass * mag; c.vz = c.vz + dz * b.mass * mag;
    }
  }
  for (let i = 0; i < n; i++) { let b = bs[i]; b.x = b.x + dt * b.vx; b.y = b.y + dt * b.vy; b.z = b.z + dt * b.vz; }
}
function run(steps) {
  let bs = bodies();
  offset(bs);
  let before = energy(bs);
  for (let i = 0; i < steps; i++) { advance(bs, 0.01); }
  return Math.round(before * 1e9) + " " + Math.round(energy(bs) * 1e9);
}
console.log(run(1000000));
