// Scanning a string one character code at a time.
function count(s, c) {
  let n = s.length;
  let k = 0;
  for (let i = 0; i < n; i++) { if (s.charCodeAt(i) === c) k++; }
  return k;
}
let s = "";
for (let i = 0; i < 2000; i++) { s = s + "abcde"; }
let t = 0;
for (let r = 0; r < 1000; r++) { t = t + count(s, 99); }
console.log(t);
